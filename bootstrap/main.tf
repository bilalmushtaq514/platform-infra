# -----------------------------------------------------------------------------
# Bootstrap stack (run ONCE, local state).
#
# Creates the things that must exist *before* the main stack can run:
#   1. Storage account + container for Terraform remote state (I-7)
#   2. A "platform" Key Vault for secrets that are created out-of-band
#      (Azure DevOps PAT used by the IIS VMs to self-register) and for
#      secrets generated by the main stack (VM admin password)       (I-9)
#
# Chicken-and-egg: this stack cannot store its own state remotely because the
# storage account does not exist yet. Its state is tiny, contains no secrets,
# and can be re-imported at any time; it is kept locally and git-ignored.
# -----------------------------------------------------------------------------

data "azurerm_client_config" "current" {}

locals {
  tags = merge(var.tags, {
    project     = var.project
    managed_by  = "terraform"
    stack       = "bootstrap"
    environment = "shared"
  })
}

resource "random_string" "suffix" {
  length  = 5
  upper   = false
  special = false
}

resource "azurerm_resource_group" "state" {
  name     = "rg-${var.project}-tfstate-${var.location_short}"
  location = var.location
  tags     = local.tags
}

resource "azurerm_storage_account" "state" {
  name                            = "st${var.project}tf${random_string.suffix.result}"
  resource_group_name             = azurerm_resource_group.state.name
  location                        = azurerm_resource_group.state.location
  account_tier                    = "Standard"
  account_replication_type        = "ZRS"
  min_tls_version                 = "TLS1_2"
  https_traffic_only_enabled      = true
  allow_nested_items_to_be_public = false
  # Force Entra ID auth for data plane: no storage keys needed by anyone.
  shared_access_key_enabled       = false
  default_to_oauth_authentication = true

  blob_properties {
    versioning_enabled = true # every state write is recoverable
    delete_retention_policy {
      days = 14
    }
    container_delete_retention_policy {
      days = 14
    }
  }

  tags = local.tags
}

resource "azurerm_storage_container" "state" {
  name                  = "tfstate"
  storage_account_id    = azurerm_storage_account.state.id
  container_access_type = "private"
}

# The identity running Terraform needs data-plane access to the blobs because
# shared keys are disabled. Locking is native: the azurerm backend takes a
# blob lease on the state file for the duration of every write operation.
resource "azurerm_role_assignment" "state_blob_contributor" {
  for_each             = toset(concat([data.azurerm_client_config.current.object_id], var.state_contributor_object_ids))
  scope                = azurerm_storage_account.state.id
  role_definition_name = "Storage Blob Data Contributor"
  principal_id         = each.value
}

resource "azurerm_key_vault" "platform" {
  name                          = "kv-${var.project}-${random_string.suffix.result}"
  resource_group_name           = azurerm_resource_group.state.name
  location                      = azurerm_resource_group.state.location
  tenant_id                     = data.azurerm_client_config.current.tenant_id
  sku_name                      = "standard"
  rbac_authorization_enabled    = true
  soft_delete_retention_days    = 7
  purge_protection_enabled      = false # assessment sandbox: allow clean teardown. true in prod.
  public_network_access_enabled = true  # private endpoint listed under "improvements"
  tags                          = local.tags
}

# Whoever runs Terraform can create/read secrets (VM password, PAT).
resource "azurerm_role_assignment" "kv_secrets_officer" {
  for_each             = toset(concat([data.azurerm_client_config.current.object_id], var.state_contributor_object_ids))
  scope                = azurerm_key_vault.platform.id
  role_definition_name = "Key Vault Secrets Officer"
  principal_id         = each.value
}
